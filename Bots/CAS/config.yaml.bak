alpaca:
  mode: paper
  data_feed: iex
ibkr:
  base_url: https://localhost:5000/v1/api
  account_id: ''
  verify_ssl: false
  keepalive_interval: 45
  rate_per_sec: 9.0
  suppress_message_ids:
  - o354
  - o163
  - o382
  - o451
broker:
  provider: alpaca
universe:
  min_avg_volume: 500000
  stocks:
  - AAPL
  - MSFT
  - NVDA
  - AMZN
  - GOOGL
  - META
  - TSLA
  etfs:
  - GLD
  - SLV
  - USO
  - XLE
  - COPX
  - XLB
  crypto:
  - ALL/ALL
  crypto_quote: USD
  min_crypto_volume: 0
  max_crypto_symbols: 100
  max_discovered: 500
strategies:
  momentum:
    enabled: true
    fast_lookback: 16
    slow_lookback: 62
    top_n: 9
    min_roe: 0.05
    max_debt_equity: 3.0
    min_gross_margin: 0.2
  gap_fade:
    enabled: true
    min_gap_pct: 2.0
    target_retracement: 0.5
    max_daily_trades: 5
  quote_imbalance:
    enabled: true
    window_size: 50
    min_score: 0.3
  trend_following:
    enabled: false
    weight: 1.0
    fast_ma: 20
    slow_ma: 50
    adx_min: 20.0
    top_n: 10
  mean_reversion:
    enabled: false
    weight: 1.0
    lookback: 20
    zscore_entry: -2.0
    rsi_oversold: 30.0
    top_n: 10
  breakout:
    enabled: false
    weight: 1.0
    channel: 20
    top_n: 10
  volatility:
    enabled: false
    weight: 1.0
    lookback: 20
    low_vol_pct: 0.15
    high_vol_pct: 0.5
    top_n: 5
  pairs_trading:
    enabled: false
    weight: 1.0
    lookback: 60
    zscore_entry: 2.0
    pairs:
    - KO/PEP
    - GLD/SLV
  dca:
    enabled: false
    weight: 1.0
    symbols:
    - SPY
    - QQQ
    cadence_days: 7
  rebalance:
    enabled: false
    weight: 1.0
    targets:
      SPY: 0.6
      GLD: 0.2
      TLT: 0.2
    drift_pct: 0.05
  ml:
    enabled: false
    weight: 1.0
    model_path: ''
    top_n: 10
  aggregator:
    enabled: true
    top_n: 10
    min_score: 0.05
    use_regime_routing: true
    regime_fit_bonus: 1.5
    regime_fit_penalty: 0.5
    regime_benchmark: SPY
  sentiment:
    enabled: false
    weight: 0.2
  crypto:
    enabled: false
    scan_interval_minutes: 15
    stop_check_interval_minutes: 5
    crypto_order_ttl_minutes: 30
    trailing_stop: false
    trail_pct: 0.05
    momentum:
      enabled: true
      weight: 1.0
      fast_ma: 21
      slow_ma: 29
      adx_min: 20.15625
      top_n: 10
    mean_reversion:
      enabled: false
      weight: 1.0
      lookback: 20
      zscore_entry: -2.0
      rsi_oversold: 30.0
      top_n: 10
    breakout:
      enabled: false
      weight: 1.0
      channel: 20
      top_n: 10
    dca:
      enabled: false
      weight: 1.0
      symbols: []
      cadence_hours: 24
    volatility:
      enabled: false
      weight: 1.0
      lookback: 20
      low_vol_pct: 0.4
      high_vol_pct: 1.2
      top_n: 5
    aggregator:
      enabled: true
      top_n: 10
      min_score: 0.05
      use_regime_routing: true
      regime_fit_bonus: 1.5
      regime_fit_penalty: 0.5
      regime_benchmark: BTC/USD
risk:
  max_risk_per_trade: 0.005
  max_positions: 15
  max_crypto_positions: 0
  max_daily_drawdown: 0.05
  atr_stop_multiplier: 6.0
  max_hold_days: 1
  flatten_eod: true
  flatten_crypto_eod: false
  maker_fee_pct: 0.0015
  taker_fee_pct: 0.0025
  min_edge_multiple: 2.0
  take_profit_pct: 0.0
logging:
  log_dir: logs
  level: INFO
web:
  enabled: false
  host: 127.0.0.1
  port: 8787
