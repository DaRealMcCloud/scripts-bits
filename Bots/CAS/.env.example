# ─────────────────────────────────────────────────────────────
# Example environment file.
# Copy to ".env" (same folder as config.yaml) and fill in your values.
#   Copy-Item .env.example .env
# The bot loads .env automatically (via python-dotenv) when it starts.
# Real shell environment variables always override values set here.
# NEVER commit your real .env — it is git-ignored.
# ─────────────────────────────────────────────────────────────

# ── Broker selection (optional; also settable in config.yaml) ──
# alpaca | ibkr
# BROKER_PROVIDER=alpaca

# ── Alpaca credentials (required when broker.provider = alpaca) ──
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── Interactive Brokers (optional; used when broker.provider = ibkr) ──
# IBKR has no API key — you log into the Client Portal Gateway in a browser.
# These only override config.yaml if set.
# IBKR_ACCOUNT_ID=DU1234567
# IBKR_BASE_URL=https://localhost:5000/v1/api
